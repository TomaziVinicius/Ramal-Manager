# -----------------------------------------------------------------------------
# Exemplo de Configuração de Ambiente (.env)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# -----------------------------------------------------------------------------

# Porta da Aplicação
PORT=3000

# Chave Secreta para Assinatura dos Tokens JWT (Gere uma chave segura e única)
JWT_SECRET=sua_chave_secreta_super_segura_jwt_2026

# Tempo de Expiração da Sessão / Token
JWT_EXPIRES_IN=8h

# Conexão com o Banco de Dados MariaDB
DB_HOST=db
DB_PORT=3306
DB_USER=ramais_user
DB_PASSWORD=ramais_secret_password
DB_NAME=ramais_db
DB_CONNECTION_LIMIT=10
